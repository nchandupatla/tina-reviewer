# Copy to .env and fill in. .env is gitignored — never commit it.

# Any OpenAI-compatible endpoint with tool calling. Default: OpenRouter.
TINA_BASE_URL=https://openrouter.ai/api/v1
TINA_API_KEY=sk-or-...

# A preset name from models.json (haiku, sonnet, free, cheap) or any raw model ID.
TINA_MODEL=haiku

# Limits
TINA_MAX_STEPS=30
TINA_CMD_TIMEOUT=60

# 1 = give the sandbox network access (e.g. for npm install). Off by default.
TINA_NET=0
