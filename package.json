{
  "name": "tina-reviewer",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Reviews TINA pull requests against the rules in LESSONS.md.",
  "scripts": {
    "check": "tsc --noEmit",
    "dev": "agent-sdk dev",
    "fixtures": "node scripts/make-fixtures.mjs ../tina ../tina-video/bugbot-cases ../tina-video/bugbot-cases/LESSONS.md",
    "eval": "agent-sdk eval --dir . --tag tina"
  },
  "dependencies": {
    "@grok/agent-sdk": "^0.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "6.0.3"
  },
  "cursorAgentTemplate": "security-reviewer"
}
